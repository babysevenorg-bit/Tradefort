# ──────────────────────────────────────────────────────────────
# Tradefort environment variables. Copy this file to `.env` and fill in.
# On Vercel, set these in Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# A Postgres connection string. Use any Postgres provider:
#   - Vercel Postgres (https://vercel.com/docs/storage/vercel-postgres)
#   - Neon           (https://neon.tech)
#   - Supabase       (https://supabase.com/docs/guides/database/connecting-to-postgres)
# Example: postgresql://user:pass@host:5432/tradefort?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tradefort

# Random 32+ char secret used to sign JWT session cookies (meridian_session).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret

# Sandbox/dev only: the dev server runs on port 3000 by default. No env needed.
