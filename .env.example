# ──────────────────────────────────────────────────────────────
# Tradefort environment variables. Copy this file to `.env` and fill in.
# On Vercel, set these in Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# A Postgres connection string. Use any Postgres provider:
#   - Vercel Postgres (https://vercel.com/docs/storage/vercel-postgres)
#   - Neon           (https://neon.tech)
#   - Supabase       (https://supabase.com/docs/guides/database/connecting-to-postgres)
# Example: postgresql://user:pass@host:5432/tradefort?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tradefort

# Random 32+ char secret used to sign JWT session cookies (meridian_session).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret

# ── Paystack (real payments: M-Pesa + Mastercard/Visa) ───────────────────
# Get these from https://dashboard.paystack.com/#/settings/keys (Live mode).
# (Secret key format: sk_live_…  Public key format: pk_live_…)
PAYSTACK_SECRET_KEY=replace-with-your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=replace-with-your-paystack-public-key
# Your deployed origin, used to build the post-payment callback URL.
# Paystack redirects the user's browser back here after they pay. Set this to
# your Vercel production domain (no trailing slash).
APP_BASE_URL=https://your-tradefort.vercel.app
# In the Paystack dashboard, also set the Webhook URL to:
#   https://your-tradefort.vercel.app/api/paystack/webhook
# (Settings → API Configuration → Webhook URL). The webhook is the
# AUTHORITATIVE payment confirmation — it's signed with HMAC-SHA512 and
# auto-settles the deposit. The browser callback also verifies server-side.
